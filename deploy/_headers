/*
  YamiHub 生产环境安全响应头
  Pages 会按路径匹配应用；wrangler pages dev 本地同样生效
*/
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' http://127.0.0.1:11434 http://localhost:11434; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
